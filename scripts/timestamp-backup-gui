#!/usr/bin/env python3
"""Launcher for Timestamp graphical user interface."""

import sys
from pathlib import Path

# Installation path
PKG_DIR = Path("/usr/lib/timestamp-backup")
if not PKG_DIR.exists():
    # Run from a source checkout (git clone): use the bundled package directory
    PKG_DIR = Path(__file__).resolve().parent.parent / "timestamp"

# Add package directory to sys.path
if str(PKG_DIR) not in sys.path:
    sys.path.insert(0, str(PKG_DIR))

# The package is installed flat in /usr/lib/timestamp-backup: register its
# __init__.py as the "timestamp" module so "from timestamp import ..."
# works in app.py, backup.config and gui.api.
_init = PKG_DIR / "__init__.py"
if _init.exists():
    import importlib.util
    spec = importlib.util.spec_from_file_location("timestamp", _init)
    mod = importlib.util.module_from_spec(spec)
    sys.modules.setdefault("timestamp", mod)
    spec.loader.exec_module(mod)

# Launch the GUI application
from app import main

if __name__ == "__main__":
    main()
