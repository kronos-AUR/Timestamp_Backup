#!/usr/bin/env python3
"""Launcher for Timestamp graphical user interface."""

import os
import sys
from pathlib import Path

# Installation path
PKG_DIR = Path("/usr/lib/timestamp")

# Add package directory to sys.path
if str(PKG_DIR) not in sys.path:
    sys.path.insert(0, str(PKG_DIR))

# Set project directory for configuration
import backup.config
CONFIG_DIR = Path.home() / ".config" / "timestamp"
CONFIG_DIR.mkdir(parents=True, exist_ok=True)
backup.config._project_root = CONFIG_DIR

# Set runtime directory
RUNTIME_DIR = Path.home() / ".local" / "share" / "timestamp" / "runtime"
RUNTIME_DIR.mkdir(parents=True, exist_ok=True)

# Launch the GUI application
from app import main

if __name__ == "__main__":
    main()
